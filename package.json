{
  "name": "order-flow-mcp",
  "version": "0.1.0",
  "description": "MCP server that gives any AI agent live crypto order flow: footprint, CVD, volume profile, aggregated order books, big prints, liquidations, open interest, funding, absorption and icebergs across 10 exchanges.",
  "type": "module",
  "bin": {
    "order-flow-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "order-flow",
    "footprint",
    "crypto",
    "market-data",
    "claude",
    "codex",
    "ai-agent"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zadescoxp/order-flow-mcp.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@siebly/htx-api": "1.0.8",
    "@siebly/hyperliquid-api": "1.0.3",
    "@siebly/kraken-api": "1.1.10",
    "binance": "3.6.12",
    "bitget-api": "3.2.8",
    "bybit-api": "4.8.5",
    "coinbase-api": "1.3.1",
    "gateio-api": "1.6.9",
    "https-proxy-agent": "^7.0.6",
    "kucoin-api": "2.6.10",
    "okx-api": "3.2.10",
    "undici": "^7.30.2",
    "ws": "^8.23.0",
    "zod": "^3.25.76",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "@siebly/kraken-api": {
      "axios": "1.21.1"
    }
  }
}
